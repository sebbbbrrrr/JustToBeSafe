        {
          "id": "overview",
          "title": "What can stop working",
          "kind": "context",
          "draft_prompt": "Consider lights, refrigeration, cooking, charging, lifts, access systems, heating, internet and medical equipment. Identify building-specific dependencies.",
          "status": "draft"
        },
        {
          "id": "before",
          "title": "Prepare beforehand",
          "kind": "planning",
          "draft_prompt": "Audit existing torches, batteries, phone chargers, important contact details, and equipment that depends on mains electricity. No unreviewed operational safety advice.",
          "status": "draft"
        },
        {
          "id": "during",
          "title": "During an outage",
          "kind": "safety_requires_review",
          "draft_prompt": "Obtain specialist-reviewed guidance with verified official advice, building-specific constraints, and escalation when necessary. Not publishable as-is.",
          "status": "blocked_expert_review"
        },
        {
          "id": "after",
          "title": "After power returns",
          "kind": "safety_requires_review",
          "draft_prompt": "Develop reviewed restoration, food-safety, equipment and follow-up checks. Not publishable as-is.",
          "status": "blocked_expert_review"
        },
        {
          "id": "household",
          "title": "Household information to record",
          "kind": "plan_fields",
          "draft_prompt": "Electricity network contact, building-management contact, meeting arrangements, accessibility and mains-dependent equipment. Keep private household values out of the guide content database.",
          "status": "draft"
        },
        {
          "id": "supplies",
          "title": "Related inventory and plan items",
          "kind": "integration",
          "draft_prompt": "Link optional torches, batteries, power banks, water, shelf-stable foods and manual equipment checks; never claim checked stock proves readiness.",
          "status": "draft"
        },
        {
          "id": "sources",
          "title": "Official sources and review status",
          "kind": "metadata",
          "draft_prompt": "Track original source, scope, licences, reviewer, next review, offline snapshot version, live-online warning distinctions.",
          "status": "draft"
        }
      ]
